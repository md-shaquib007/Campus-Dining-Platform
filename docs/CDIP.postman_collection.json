{
  "info": {
    "name": "CDIP API",
    "description": "Campus Dining Intelligence Platform API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data?.accessToken) {",
                "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"student@demo.edu\",\"password\":\"Student@123\"}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"YOUR_REFRESH_TOKEN\"}" },
            "url": "{{baseUrl}}/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/analytics/dashboard"
          }
        }
      ]
    },
    {
      "name": "Menus",
      "item": [
        {
          "name": "Get Menu",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/menus?diningHallId=seed-dining-hall&date=2026-07-09",
              "host": ["{{baseUrl}}"],
              "path": ["menus"],
              "query": [
                { "key": "diningHallId", "value": "seed-dining-hall" },
                { "key": "date", "value": "2026-07-09" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Ratings",
      "item": [
        {
          "name": "Submit Rating",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"mealId\":\"MEAL_ID\",\"taste\":4,\"quality\":5,\"quantity\":3,\"hygiene\":5,\"variety\":4,\"temperature\":4,\"overall\":4}"
            },
            "url": "{{baseUrl}}/ratings"
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "List Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/complaints"
          }
        },
        {
          "name": "File Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Cold food served\",\"description\":\"Lunch was served cold today at 12:30 PM\",\"category\":\"COLD_FOOD\"}"
            },
            "url": "{{baseUrl}}/complaints"
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Global Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/search?q=food&type=all",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "food" },
                { "key": "type", "value": "all" }
              ]
            }
          }
        }
      ]
    }
  ]
}
