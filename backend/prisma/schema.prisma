generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  COLLEGE_ADMIN
  WARDEN
  MESS_OPERATOR
  STUDENT
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ComplaintCategory {
  BAD_TASTE
  COLD_FOOD
  HYGIENE_ISSUE
  FOREIGN_OBJECT
  DELAY
  QUANTITY_ISSUE
  STAFF_BEHAVIOUR
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum SuggestionCategory {
  NEW_DISH
  BETTER_TIMING
  BETTER_QUALITY
  FESTIVAL_MENU
  OTHER
}

enum MealSkipReason {
  GOING_HOME
  FASTING
  MEDICAL
  VACATION
  OTHER
}

enum MealSkipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementType {
  HOLIDAY_MENU
  FESTIVAL_MENU
  TIMING_CHANGE
  SPECIAL_MEAL
  GENERAL
}

enum NotificationType {
  MENU_PUBLISHED
  POLL_CREATED
  COMPLAINT_RESOLVED
  SPECIAL_DINNER
  MEAL_SKIP_APPROVED
  RATING_REMINDER
  ANNOUNCEMENT
  GENERAL
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  SEMESTER
  YEARLY
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// ─── Platform ────────────────────────────────────────────────────────────────

model College {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  address     String?
  city        String?
  state       String?
  country     String   @default("India")
  website     String?
  phone       String?
  primaryColor String?  @default("#6366f1")
  subdomain   String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscription   Subscription?
  hostels        Hostel[]
  diningHalls    DiningHall[]
  users          User[]
  announcements  Announcement[]
  polls          Poll[]
  complaints     Complaint[]
  suggestions    Suggestion[]
  contractors    Contractor[]
  auditLogs      AuditLog[]
  reports        Report[]

  @@index([slug])
  @@index([isActive])
}

model Subscription {
  id         String             @id @default(uuid())
  collegeId  String             @unique
  plan       SubscriptionPlan   @default(FREE)
  status     SubscriptionStatus @default(TRIAL)
  startDate  DateTime           @default(now())
  endDate    DateTime?
  maxUsers   Int                @default(500)
  maxHostels Int                @default(5)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

// ─── Hostel Structure ────────────────────────────────────────────────────────

model Hostel {
  id          String   @id @default(uuid())
  collegeId   String
  name        String
  code        String
  description String?
  capacity    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college     College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  blocks      Block[]
  students    Student[]
  wardens     Warden[]
  diningHall  DiningHall?
  mealSkips   MealSkip[]
  attendance  Attendance[]

  @@unique([collegeId, code])
  @@index([collegeId])
}

model Block {
  id        String   @id @default(uuid())
  hostelId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostel Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floors Floor[]

  @@unique([hostelId, name])
}

model Floor {
  id        String   @id @default(uuid())
  blockId   String
  number    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  block Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@unique([blockId, number])
}

model Room {
  id        String   @id @default(uuid())
  floorId   String
  number    String
  capacity  Int      @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor    Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([floorId, number])
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  collegeId       String?
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatar          String?
  role            UserRole
  isVerified      Boolean   @default(false)
  isActive        Boolean   @default(true)
  verifyToken     String?
  resetToken      String?
  resetTokenExp   DateTime?
  refreshTokenHash String?
  ratingStreak    Int       @default(0)
  lastRatedAt     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  college       College?       @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  student       Student?
  warden        Warden?
  contractor    Contractor?
  ratings       Rating[]
  reviews       Review[]
  complaints    Complaint[]
  suggestions   Suggestion[]
  votes         Vote[]
  notifications Notification[]
  auditLogs     AuditLog[]
  reports       Report[]

  @@index([collegeId])
  @@index([role])
  @@index([email])
  @@index([collegeId, role, isActive])
}

model Student {
  id           String   @id @default(uuid())
  userId       String   @unique
  hostelId     String
  roomId       String?
  rollNumber   String
  department   String?
  year         Int?
  semester     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostel    Hostel     @relation(fields: [hostelId], references: [id])
  room      Room?      @relation(fields: [roomId], references: [id])
  mealSkips MealSkip[]
  attendance Attendance[]

  @@unique([hostelId, rollNumber])
  @@index([hostelId])
}

model Warden {
  id        String   @id @default(uuid())
  userId    String   @unique
  hostelId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
}

model Contractor {
  id          String   @id @default(uuid())
  userId      String   @unique
  collegeId   String
  companyName String
  licenseNo   String?
  rating      Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  college     College      @relation(fields: [collegeId], references: [id])
  diningHalls DiningHall[]

  @@index([collegeId])
}

// ─── Dining ──────────────────────────────────────────────────────────────────

model DiningHall {
  id           String   @id @default(uuid())
  collegeId    String
  hostelId     String?  @unique
  contractorId String?
  name         String
  capacity     Int      @default(200)
  location     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college    College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  hostel     Hostel?     @relation(fields: [hostelId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  menus      Menu[]
  timings    MealTiming[]

  @@index([collegeId])
}

model MealTiming {
  id           String   @id @default(uuid())
  diningHallId String
  mealType     MealType
  startTime    String
  endTime      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diningHall DiningHall @relation(fields: [diningHallId], references: [id], onDelete: Cascade)

  @@unique([diningHallId, mealType])
}

model Menu {
  id           String     @id @default(uuid())
  diningHallId String
  menuDate     DateTime   @db.Date
  status       MenuStatus @default(DRAFT)
  isSpecialEvent Boolean  @default(false)
  eventName    String?
  publishedAt  DateTime?
  publishedBy  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  diningHall DiningHall @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  meals      Meal[]

  @@unique([diningHallId, menuDate])
  @@index([menuDate])
  @@index([status])
  @@index([diningHallId, menuDate, status])
}

model Meal {
  id          String   @id @default(uuid())
  menuId      String
  mealType    MealType
  startTime   String?
  endTime     String?
  isAvailable Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menu    Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dishes  Dish[]
  ratings Rating[]

  @@unique([menuId, mealType])
}

model Dish {
  id           String   @id @default(uuid())
  mealId       String
  name         String
  description  String?
  image        String?
  isVegetarian Boolean  @default(true)
  isSpecial    Boolean  @default(false)
  calories     Int?
  protein      Float?
  carbs        Float?
  fat          Float?
  allergens    String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

// ─── Feedback ────────────────────────────────────────────────────────────────

model Rating {
  id          String   @id @default(uuid())
  mealId      String
  userId      String
  taste       Int
  quality     Int
  quantity    Int
  hygiene     Int
  variety     Int
  temperature Int
  overall     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mealId, userId])
  @@index([mealId])
  @@index([userId])
  @@index([mealId, createdAt])
}

model Review {
  id          String   @id @default(uuid())
  mealId      String?
  userId      String
  content     String
  sentimentScore Float?
  isAnonymous Boolean  @default(false)
  isComplaint Boolean  @default(false)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mealId])
}

model Complaint {
  id          String            @id @default(uuid())
  collegeId   String
  userId      String
  mealId      String?
  category    ComplaintCategory
  status      ComplaintStatus   @default(OPEN)
  title       String
  description String
  image       String?
  response    String?
  dueBy       DateTime?
  sentimentScore Float?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId, status])
  @@index([userId])
  @@index([category])
  @@index([collegeId, status, dueBy])
}

model Suggestion {
  id          String             @id @default(uuid())
  collegeId   String
  userId      String
  category    SuggestionCategory
  title       String
  description String
  upvotes     Int                @default(0)
  isApproved  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([upvotes])
}

model MealSkip {
  id        String         @id @default(uuid())
  studentId String
  hostelId  String
  skipDate  DateTime       @db.Date
  mealType  MealType
  reason    MealSkipReason
  status    MealSkipStatus @default(PENDING)
  notes     String?
  approvedBy String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel  Hostel  @relation(fields: [hostelId], references: [id])

  @@unique([studentId, skipDate, mealType])
  @@index([hostelId, skipDate])
  @@index([status])
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  hostelId  String
  date      DateTime @db.Date
  mealType  MealType
  attended  Boolean  @default(true)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel  Hostel  @relation(fields: [hostelId], references: [id])

  @@unique([studentId, date, mealType])
  @@index([hostelId, date])
}

// ─── Engagement ──────────────────────────────────────────────────────────────

model Poll {
  id          String     @id @default(uuid())
  collegeId   String
  title       String
  description String?
  status      PollStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  college College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@index([collegeId, status])
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String
  voteCount Int      @default(0)
  createdAt DateTime @default(now())

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
}

model Vote {
  id        String   @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

model Announcement {
  id          String           @id @default(uuid())
  collegeId   String
  title       String
  content     String
  type        AnnouncementType @default(GENERAL)
  isPinned    Boolean          @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([publishedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ─── Reports & Audit ─────────────────────────────────────────────────────────

model Report {
  id          String       @id @default(uuid())
  collegeId   String
  generatedBy String
  type        ReportType
  format      ReportFormat
  filePath    String?
  startDate   DateTime
  endDate     DateTime
  metadata    Json?
  createdAt   DateTime     @default(now())

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  generator User    @relation(fields: [generatedBy], references: [id])

  @@index([collegeId, type])
}

model AuditLog {
  id        String   @id @default(uuid())
  collegeId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([userId])
  @@index([createdAt])
}
